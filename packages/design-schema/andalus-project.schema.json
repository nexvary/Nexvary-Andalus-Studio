{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexvary.com/schemas/andalus-project.schema.json",
  "title": "Nexvary Andalus Studio Project",
  "type": "object",
  "required": [
    "projectId",
    "name",
    "styleSchool",
    "locks",
    "units",
    "version"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.4.25"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "locale": {
      "type": "string",
      "enum": ["ar", "en", "tr"],
      "default": "ar"
    },
    "units": {
      "type": "string",
      "enum": ["metric", "imperial"],
      "default": "metric"
    },
    "styleSchool": {
      "type": "string",
      "enum": [
        "nasrid-granada",
        "cordoban",
        "moroccan-andalusian",
        "mamluk",
        "ottoman",
        "damascene",
        "contemporary-andalusian"
      ]
    },
    "ornamentIntensity": {
      "type": "string",
      "enum": ["calm", "balanced", "luxury", "royal", "historic"],
      "default": "balanced"
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "massing",
        "floorCount",
        "openings",
        "entrance",
        "roofline",
        "roomBoundaries"
      ],
      "properties": {
        "massing": {"type": "boolean", "default": true},
        "floorCount": {"type": "boolean", "default": true},
        "openings": {"type": "boolean", "default": true},
        "entrance": {"type": "boolean", "default": false},
        "roofline": {"type": "boolean", "default": true},
        "roomBoundaries": {"type": "boolean", "default": true}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["photo", "floorplan", "scan", "blank"]},
        "provenance": {"type": "string", "maxLength": 1000},
        "widthPx": {"type": "integer", "minimum": 1},
        "heightPx": {"type": "integer", "minimum": 1}
      }
    },
    "floorPlan": {
      "type": "object",
      "properties": {
        "walls": {"type": "array", "maxItems": 2000},
        "openings": {"type": "array", "maxItems": 2000},
        "rooms": {"type": "array", "maxItems": 1000}
      },
      "additionalProperties": true
    },
    "patternPresets": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["type", "parameters"],
        "properties": {
          "type": {"type": "string", "enum": ["star", "rosette", "zellij-grid", "border"]},
          "parameters": {"type": "object"}
        }
      }
    },
    "rendering": {
      "type": "object",
      "properties": {
        "quality": {"type": "string", "enum": ["draft", "preview", "high", "ultra"], "default": "preview"},
        "environment": {"type": "string", "default": "courtyard-day"},
        "realWorldScale": {"type": "boolean", "default": true}
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "generatorVersion": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
